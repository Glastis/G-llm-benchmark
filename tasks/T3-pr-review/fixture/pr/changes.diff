+    std::string sql = "SELECT * FROM loans WHERE member_id = ?";
+    if (open_only) {
+        sql += " AND returned IS NULL";
+    }
+    Statement rows = query(db_, sql + " ORDER BY borrowed, id", member_id);
+    std::vector<Loan> loans;
+    while (rows.step()) {
+        loans.push_back(Loan::from_row(rows));
+    }
+    return loans;
+}
