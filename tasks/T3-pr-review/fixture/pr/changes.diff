+        {
+            std::unique_lock lock(queue_mutex_);
+            queue_ready_.wait(lock, [this] { return !queue_.empty(); });
+            loan = std::move(queue_.front());
+            queue_.pop_front();
+        }
+        if (!loan) {
+            return;
+        }
+        if (reminded_.contains(loan->id)) {
